# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit real secrets. See AGENTS.md for secret-handling rules.

# --- Firebase client SDK ---
# Safe to expose to the browser (NEXT_PUBLIC_ vars are inlined at build time).
# Get these from Firebase Console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only) ---
# Never prefix these with NEXT_PUBLIC_ -- must never reach the browser bundle.
# Get these from Firebase Console > Project settings > Service accounts >
# Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Authorization (server-only) ---
# The only Google account currently allowed to sign in to the dashboard.
# Compared against the verified email from the Firebase ID token -- never
# trust a client-supplied email/role.
SUPER_ADMIN_EMAIL=

# --- Mistral OCR (server-only) ---
# Never prefix with NEXT_PUBLIC_ -- must never reach the browser bundle.
# Get this from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- OpenAI (server-only) ---
# Never prefix with NEXT_PUBLIC_ -- must never reach the browser bundle.
# Used by the lib/ai service to translate Arabic source text to English and
# to generate simplified learning material from source text, and to
# generate the embeddings indexed in Pinecone (see below).
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Pinecone (server-only) ---
# Never prefix with NEXT_PUBLIC_ -- must never reach the browser bundle.
# Used to index book sections for search when a book is created or edited.
# The index named below must already exist, created with Pinecone's
# integrated inference enabled for the llama-text-embed-v2 model at 2048
# dimensions and the cosine metric -- Pinecone computes embeddings from
# record text server-side, so no separate embedding-provider key is needed.
# Get the API key from https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=
